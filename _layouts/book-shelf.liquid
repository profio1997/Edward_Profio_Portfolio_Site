---
layout: page
---
{{ content }}

<script>
  // Cover chain: Open Library (in the <img>) -> Google Books -> local fallback image -> plain title tile.
  window.bookCoverFallback = function (img) {
    var stage = parseInt(img.getAttribute('data-stage') || '0', 10);
    var isbn = img.getAttribute('data-isbn');
    var fb = img.getAttribute('data-fallback');
    if (stage === 0 && isbn) {
      img.setAttribute('data-stage', '1');
      img.src = 'https://books.google.com/books/content?vid=ISBN' + isbn + '&printsec=frontcover&img=1&zoom=1';
      return;
    }
    if (stage <= 1 && fb) {
      img.setAttribute('data-stage', '2');
      img.src = fb;
      return;
    }
    img.onerror = null;
    var tile = document.createElement('div');
    tile.className = 'cover-fallback';
    tile.textContent = img.getAttribute('data-title') || '';
    img.replaceWith(tile);
  };
</script>

{% if page.collection and page.collection.size > 0 %}
  {% assign collection = site[page.collection] %}
  {% if collection and collection.size > 0 %}
    {%- comment -%} Order: in-progress ("reading") first, then the original books, then the "more" group by shelf_rank. {%- endcomment -%}
    {% assign ordered = '' | split: '' %}
    {% for item in collection reversed %}
      {% assign item_status = item.status | downcase | strip %}
      {% if item_status == 'reading' %}{% assign ordered = ordered | push: item %}{% endif %}
    {% endfor %}
    {% assign dated = collection | sort: 'date' | reverse %}
    {% for item in dated %}
      {% assign item_status = item.status | downcase | strip %}
      {% if item_status != 'reading' %}{% assign ordered = ordered | push: item %}{% endif %}
    {% endfor %}
    {% assign favorites = collection | where: 'favorite', true | sort: 'date' | reverse %}
    {% assign year_list = '' | split: '' %}
    {% for item in ordered %}
      {% assign yy = item.date | date: '%Y' %}
      {% unless year_list contains yy %}{% assign year_list = year_list | push: yy %}{% endunless %}
    {% endfor %}
    <nav class="book-year-jump" aria-label="Jump to a year">
      {% if favorites.size > 0 %}<button type="button" class="fav-filter" aria-pressed="false"><i class="fa-solid fa-star" aria-hidden="true"></i> Favorites <span class="fav-count">{{ favorites.size }}</span></button>{% endif %}
      {% for yy in year_list %}<button type="button" class="year-filter" data-year="{{ yy }}" aria-pressed="false">{{ yy }}</button>{% endfor %}
    </nav>
    {% for item in ordered %}
      {% assign current_year = item.date | date: '%Y' %}
      {% if current_year != year %}
        {% unless forloop.first %}
          </div>
        {% endunless %}
        <h2 id="y{{ current_year }}" class="book-year">
          <a href="{{ current_year | prepend: '/books/' | relative_url }}">{{ current_year }}</a>
        </h2>
        <div class="book-grid">
          {% assign year = current_year %}
      {% endif %}
      {% include book_tile.liquid item=item %}
      {% if forloop.last %}
        </div>
      {% endif %}
    {% endfor %}
  {% endif %}
{% endif %}

<script>
  // Favorites and year chips filter the shelf. Click a chip to filter, click it again to clear.
  // A year and Favorites can be combined (for example favorites from 2023).
  (function () {
    var nav = document.querySelector('.book-year-jump');
    if (!nav) return;
    var fav = nav.querySelector('.fav-filter');
    var years = [].slice.call(nav.querySelectorAll('.year-filter'));
    var state = { fav: false, year: null };
    var count = document.createElement('p');
    count.className = 'book-filter-count'; count.setAttribute('aria-live', 'polite');
    nav.insertAdjacentElement('afterend', count);

    function apply() {
      document.body.classList.toggle('book-fav-only', state.fav);
      if (fav) fav.setAttribute('aria-pressed', state.fav ? 'true' : 'false');
      years.forEach(function (b) { b.setAttribute('aria-pressed', state.year === b.getAttribute('data-year') ? 'true' : 'false'); });
      var shown = 0;
      document.querySelectorAll('.book-grid').forEach(function (g) {
        var h = g.previousElementSibling;
        var yr = h && h.id ? h.id.replace('y', '') : '';
        var okYear = !state.year || yr === state.year;
        var n = [].slice.call(g.querySelectorAll('figure.cover')).filter(function (f) { return !state.fav || f.hasAttribute('data-fav'); }).length;
        var visible = okYear && n > 0;
        g.style.display = visible ? '' : 'none';
        if (h && h.classList.contains('book-year')) h.style.display = visible ? '' : 'none';
        if (visible) shown += n;
      });
      years.forEach(function (b) {
        var g = document.getElementById('y' + b.getAttribute('data-year'));
        g = g && g.nextElementSibling;
        var n = g ? [].slice.call(g.querySelectorAll('figure.cover')).filter(function (f) { return !state.fav || f.hasAttribute('data-fav'); }).length : 0;
        b.style.display = n ? '' : 'none';
      });
      count.textContent = (state.fav || state.year) ? (shown + (shown === 1 ? ' book' : ' books') + (state.year ? ' from ' + state.year : '') + (state.fav ? ', favorites only' : '')) : '';
      count.style.display = count.textContent ? '' : 'none';
    }
    if (fav) fav.addEventListener('click', function () { state.fav = !state.fav; apply(); });
    years.forEach(function (b) {
      b.addEventListener('click', function () {
        var y = b.getAttribute('data-year'); state.year = state.year === y ? null : y; apply();
        var top = document.querySelector('h2.book-year:not([style*="none"])');
        if (top) window.scrollTo({ top: top.getBoundingClientRect().top + window.scrollY - 130, behavior: 'smooth' });
      });
    });
    var h = (location.hash || '').match(/^#y(\d{4})$/);
    if (h) { state.year = h[1]; apply(); }
    apply();
  })();
</script>
