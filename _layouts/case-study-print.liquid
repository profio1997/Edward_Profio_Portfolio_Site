{%- assign cs = site.data.case_studies[page.case_study] -%}
<!doctype html>
<html lang="en"><head><meta charset="utf-8"><title>{{ cs.title }} · Edward Profio</title>
<style>
@page { size: 8.5in 11in; margin: .55in 0 .7in; }
@page :first { margin: 0; }
:root{--navy:#0c1a33;--navy2:#15325e;--ink:#1a2233;--mut:#5a6578;--line:#e1e6ee;--soft:#f5f7fa;--acc:#1d64c4;--acc2:#64b5f6;--accbg:#eaf2fd;--warm:#b45309}
*{box-sizing:border-box;margin:0;padding:0}
html{-webkit-print-color-adjust:exact;print-color-adjust:exact}
body{font-family:Inter,system-ui,sans-serif;color:var(--ink);font-size:9.4pt;line-height:1.5;padding:0 .6in}.cs-prose p,p{orphans:3;widows:3}
.cover{height:11in;margin:0 -.6in;display:flex;flex-direction:column;overflow:hidden;break-after:page}
.hero{background:#14233f;color:#fff;padding:.45in .6in .3in;position:relative;overflow:hidden}

.brand{display:flex;justify-content:space-between;font-size:7.4pt;letter-spacing:.14em;text-transform:uppercase;color:#9cc7f5;font-weight:600;position:relative}
.kicker{font-size:7.6pt;letter-spacing:.15em;text-transform:uppercase;color:var(--acc2);font-weight:600;margin-top:.22in;position:relative}
h1{font-size:23pt;line-height:1.12;letter-spacing:-.02em;font-weight:750;margin:6px 0 8px;position:relative;max-width:6.6in}
.lede{font-size:10pt;color:#d5deec;line-height:1.5;max-width:6.9in;position:relative}
.meta{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;margin-top:13px;padding-top:10px;border-top:1px solid rgba(255,255,255,.2);position:relative}
.meta dt{font-size:6.6pt;letter-spacing:.12em;text-transform:uppercase;color:var(--acc2);font-weight:600}
.meta dd{font-size:8.2pt;color:#eef2fa;line-height:1.35}
.cover-body{padding:.22in .6in 0;flex:1;display:flex;flex-direction:column;min-height:0}
.hero-links{margin-top:9px;font-size:8.6pt;color:#c9d6ee}.hero-links span{opacity:.75}.hero-links b{color:#fff;font-weight:600}
.cover-img{flex:1;min-height:0;margin:.16in 0 .14in;border-radius:6px;overflow:hidden;background:#efece7}
.cover-img img{width:100%;height:100%;object-fit:cover;display:block}
.cover-foot{height:.62in;flex:none}
/* body */
.cs-tldr{border:1px solid var(--line);border-left:4px solid var(--acc);border-radius:10px;padding:8px 13px 3px;background:var(--soft)}
.cs-tldr__label{font-family:'JetBrains Mono',monospace;font-weight:700;font-size:8pt;color:var(--acc);margin-bottom:2px}
.cs-tldr__row{display:grid;grid-template-columns:.95in 1fr;gap:10px;padding:5px 0;border-top:1px solid var(--line);font-size:8.6pt}
.cs-tldr__row:first-of-type{border-top:0}.cs-tldr__row span{font-weight:700}
.cs-metrics{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:10px}
.cs-metric{border:1px solid var(--line);border-radius:10px;padding:8px 10px}
.cs-metric__n{font-size:18pt;font-weight:750;color:var(--acc);letter-spacing:-.02em;line-height:1.05}
.cs-metric__l{font-size:7.3pt;color:var(--mut);line-height:1.35;margin-top:3px}
.cs-skills{display:none}
.cs-section{margin-top:16px}
.cs-break{margin-top:16px}
.cs-h2{font-size:13pt;letter-spacing:-.01em;color:var(--navy);margin-bottom:7px;display:flex;gap:8px;align-items:baseline;break-after:avoid}
.cs-h3{font-size:10.6pt;font-weight:700;color:var(--navy);margin:12px 0 5px;padding-top:7px;border-top:.6pt solid #d5d9e2;break-after:avoid}
.cs-section>.cs-h3:first-child{border-top:0;padding-top:0;margin-top:0}
.cs-h2__n{font-family:'JetBrains Mono',monospace;font-size:8pt;color:var(--acc);font-weight:700}
.cs-prose p{margin-bottom:6px}.cs-prose ul{margin:0 0 6px 15px}.cs-prose li{margin-bottom:3px}
.cs-list{margin:0 0 4px 15px}.cs-list li{margin-bottom:4px}
li::marker{color:var(--acc)}
strong{font-weight:700}
.cs-quote{border-left:3px solid var(--acc);padding:2px 0 2px 12px;margin:6px 0 10px;break-inside:avoid}
.cs-quote p{font-size:10.5pt;font-style:italic;line-height:1.5}.cs-quote cite{font-size:7.6pt;color:var(--mut);font-style:normal}
.cs-split{display:grid;grid-template-columns:1.15fr 1fr;gap:18px;align-items:start;margin:4px 0 10px;break-inside:avoid}
.cs-split--phone{grid-template-columns:1.6fr 1fr}
figure{margin:0;break-inside:avoid}
.cs-fig img{width:100%;border:1px solid var(--line);border-radius:8px;display:block}
figcaption,.cs-cap{font-size:7.2pt;color:var(--mut);margin-top:4px;line-height:1.4}
.cs-phone{text-align:center}.cs-phone img{width:100%;max-width:2.05in;display:block;margin:0 auto}
.cs-split .cs-phone img{max-width:2.2in}
.cs-phones{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:4px 0 8px;break-inside:avoid}
.cs-phones .cs-phone img{max-width:1.62in}
.cs-browsers{display:grid;gap:12px;margin:4px 0 10px}.cs-browsers--2{grid-template-columns:1fr 1fr}
.cs-browser img{max-width:100%;max-height:3.25in;width:auto;margin:0 auto;display:block}.cs-browser figcaption{max-width:6.4in;margin-left:auto;margin-right:auto}.cs-browser{break-inside:avoid}
.cs-gallery{display:grid;grid-template-columns:1fr 1fr 1fr;gap:9px 10px;margin:4px 0 8px}.cs-gallery figure{break-inside:avoid}.cs-fig img[src*="/case_studies/workday/"]{max-height:3.6in;width:auto;margin:0 auto;border:1px solid var(--line) !important}
.cs-fig img,.cs-fig--dark img{border:0 !important;background:none !important;border-radius:0}
.cs-bars{border:1px solid var(--line);border-radius:10px;padding:10px 12px;background:var(--soft)}
.cs-bars__title{font-weight:700;font-size:9pt}.cs-bars__sub{font-size:7.2pt;color:var(--mut)}
.cs-bars__chart{display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:end;margin-top:8px}
.cs-bars__col{display:flex;flex-direction:column;align-items:center;justify-content:flex-end}
.cs-bars__val{font-weight:750;font-size:12pt;color:#7a869b}.cs-bars__val.hi{color:var(--acc)}
.cs-bars__bar{width:68%;background:#a9b4c7;border-radius:4px 4px 0 0}.cs-bars__bar.hi{background:var(--acc)}
.cs-bars__lab{min-height:2.9em;width:100%;text-align:center;font-size:7.2pt;line-height:1.3;margin-top:4px;padding-top:4px;border-top:1px solid #cfd6e2}
.cs-bars .cs-cap{margin-top:6px}
.cs-decisions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:4px 0 10px}
.cs-dec{border:1px solid var(--line);border-left:3px solid var(--acc);border-radius:8px;padding:7px 10px 4px;break-inside:avoid}
.cs-dec:last-child:nth-child(odd){grid-column:1/-1}
.cs-dec h4{font-size:9pt;color:var(--navy);margin-bottom:2px}.cs-dec p{font-size:8.2pt;line-height:1.42;margin-bottom:3px}
.cs-dec__rej{font-size:7.6pt !important;color:var(--mut)}.cs-dec__rej span{color:var(--warm);font-weight:600}
.cs-insights{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:4px 0 10px;break-inside:avoid}
.cs-insight{border:1px solid var(--line);border-radius:8px;padding:8px 10px;background:var(--soft)}
.cs-insight__n{display:inline-flex;width:16px;height:16px;border-radius:50%;background:var(--acc);color:#fff;font-size:7pt;font-weight:700;align-items:center;justify-content:center}
.cs-insight h4{font-size:8.8pt;margin:4px 0 2px;color:var(--navy)}.cs-insight p{font-size:8pt;line-height:1.42}
.cs-flow{list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(1in,1fr));gap:6px;margin:4px 0 10px;break-inside:avoid}
.cs-step{border:1px solid #cfe0f5;border-radius:8px;padding:7px 8px;background:#fff;display:flex;flex-direction:column;gap:1px}
.cs-step__tag{font-size:6.4pt;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--acc)}
.cs-step strong{font-size:8.3pt;line-height:1.25;color:var(--navy)}.cs-step__d{font-size:7.2pt;color:var(--mut);line-height:1.35}.cs-step__r{font-size:8pt;font-weight:750;color:var(--acc)}
.cs-table-wrap{border:1px solid var(--line);border-radius:9px;overflow:hidden;margin:4px 0 10px}
.cs-table{width:100%;border-collapse:collapse;font-size:8.2pt}
.cs-table th{text-align:left;font-size:6.6pt;letter-spacing:.1em;text-transform:uppercase;color:var(--mut);font-weight:600;padding:5px 8px;border-bottom:1.5px solid var(--navy);background:var(--soft)}
.cs-table td{padding:5px 8px;border-bottom:1px solid var(--line);vertical-align:top;line-height:1.38}
.cs-table tr{break-inside:avoid}.cs-table tr:last-child td{border-bottom:0}
.cs-table td.cs-em{color:var(--acc);font-weight:700}.cs-table td.cs-em-soft{font-weight:600}
.cs-table--center th:not(:first-child),.cs-table--center td:not(:first-child){text-align:center}
.cs-table td.cs-yes{color:var(--acc);font-weight:700}.cs-table td.cs-no{color:#8d97a8}
.cs-roadmap{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:4px 0 10px;break-inside:avoid}
.cs-road{border:1px solid var(--line);border-radius:8px;padding:7px 9px;background:var(--soft)}
.cs-road__h{font-weight:800;font-size:10pt;color:var(--acc);display:flex;justify-content:space-between;align-items:baseline}.cs-road__h span{font-size:7pt;font-weight:500;color:var(--mut)}
.cs-road__item{border-top:1px solid var(--line);padding:4px 0;display:flex;flex-direction:column}.cs-road__item strong{font-size:8.3pt}.cs-road__item span{font-size:7.4pt;color:var(--mut);line-height:1.35}
.cs-rai{background:var(--accbg);border:1px solid #bcd5f3;border-radius:11px;padding:10px 13px 6px;margin:8px 0 10px;break-inside:avoid}
.cs-rai__head{display:flex;justify-content:space-between;align-items:center;margin-bottom:5px}.cs-rai__head h3{font-size:10.5pt;color:var(--acc)}
.cs-badge{font-size:6.4pt;letter-spacing:.12em;text-transform:uppercase;font-weight:700;color:#fff;background:var(--acc);padding:2px 7px;border-radius:99px}
.cs-rai__grid{display:grid;grid-template-columns:1fr 1fr;gap:6px 14px}.cs-rai__grid strong{font-size:8.5pt;color:var(--navy)}.cs-rai__grid p{font-size:8pt;line-height:1.42;color:#1d3150}
.cs-rai__note{font-size:7.6pt;color:#5a4a1a;background:#fdf3e1;border-radius:6px;padding:5px 8px;margin-top:6px}
.cs-learn{border-top:2px solid var(--navy);padding-top:9px}

.cs-mocknote{display:inline-block;font-size:6.6pt;color:var(--mut);border:1px dashed #cfd6e2;border-radius:99px;padding:1px 7px;margin:0 0 5px}
.cs-media{margin:4px 0 8px}.cs-mocknote{break-after:avoid}
.cs-phones--2{grid-template-columns:repeat(2,minmax(0,2.1in));justify-content:center}
.cs-phone figcaption{text-align:left}
.cs-metric--basis{border-style:dashed}.cs-metric--basis .cs-metric__n{color:#3a4456}
.cs-metric__tag{display:inline-block;font-size:5.8pt;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--mut);border:1px solid var(--line);border-radius:99px;padding:0 5px;margin-bottom:2px}
.cs-system{border:1px solid var(--line);border-radius:10px;padding:9px 11px;margin:4px 0 10px;break-inside:avoid;background:var(--soft)}
.cs-system__title{font-weight:700;font-size:9pt;margin-bottom:6px}
.cs-system__row{list-style:none;display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.cs-system__step{border-top:2.5px solid var(--acc);padding-top:4px;position:relative}
.cs-system__step:last-child{border-top-color:#1f9d55}
.cs-system__step:not(:last-child)::after{content:"\2192";position:absolute;right:-11px;top:-9px;color:var(--acc);font-weight:700;font-size:9pt}
.cs-system__h{display:block;font-size:6.6pt;letter-spacing:.1em;text-transform:uppercase;font-weight:700;color:var(--acc)}
.cs-system__step:last-child .cs-system__h{color:#1f9d55}
.cs-system__t{display:block;font-size:7.8pt;line-height:1.38}
.cs-system__guard{font-size:7.6pt;color:var(--mut);margin-top:6px;padding-top:5px;border-top:1px solid var(--line)}
.cs-funnel{display:flex;flex-direction:column;align-items:center;gap:5px;margin:4px 0 10px;break-inside:avoid}
.cs-funnel__row{display:flex;align-items:center;gap:10px;border:1px solid #bcd5f3;border-radius:9px;padding:6px 11px;background:var(--accbg)}
.cs-funnel__row--1{width:100%}.cs-funnel__row--2{width:78%}.cs-funnel__row--3{width:56%;background:#d4e5fb}
.cs-funnel__n{font-size:16pt;font-weight:800;color:var(--acc);min-width:.6in}.cs-funnel__s{display:block;font-size:7.6pt;color:var(--mut)}
.cs-domains{display:grid;grid-template-columns:repeat(4,1fr);gap:7px;margin:4px 0 8px;break-inside:avoid}
.cs-domain{border:1px solid var(--line);border-radius:8px;padding:7px 8px}
.cs-domain__h{font-weight:800;color:var(--acc);font-size:9pt}.cs-domain__job{font-size:7.8pt;line-height:1.38;margin:2px 0}.cs-domain__who{font-size:7.2pt;color:var(--mut);margin-bottom:4px}
.cs-domain__v{display:flex;flex-wrap:wrap;gap:3px}.cs-domain__v span{font-size:6.8pt;padding:1px 5px;border-radius:99px;background:var(--accbg)}
</style></head>
<body>
<div class="cover">
  <div class="hero">
    <div class="brand"><span>Edward Profio · Case study</span><span>edwardprofio.com</span></div>
    <div class="kicker">{{ cs.kicker }}</div>
    <h1>{{ cs.headline }}</h1>
    <p class="lede">{{ cs.lede }}</p>
    <dl class="meta">{% for m in cs.meta %}<div><dt>{{ m.k }}</dt><dd>{{ m.v }}</dd></div>{% endfor %}</dl>
    {% if cs.links %}<p class="hero-links">{% for l in cs.links %}<span>{{ l.label }}</span> <b>{{ l.url | remove: "https://" | remove: "http://" }}</b>{% unless forloop.last %}  ·  {% endunless %}{% endfor %}</p>{% endif %}
  </div>
  <div class="cover-body">
    <div class="cs-metrics">{% for m in cs.metrics %}<div class="cs-metric{% if m.basis %} cs-metric--basis{% endif %}">{% if m.basis %}<span class="cs-metric__tag">Research</span>{% endif %}<div class="cs-metric__n">{{ m.n }}</div><div class="cs-metric__l">{% include case_study/md.liquid t=m.l %}</div></div>{% endfor %}</div>
    <div class="cover-img"><img src="{{ cs.cover | relative_url }}" alt=""></div>{% if cs.mock_note %}<p class="cs-mocknote" style="margin-top:-8px">{{ cs.mock_note }}</p>{% endif %}
  </div>
  <div class="cover-foot"></div>
</div>
{%- assign body = "" -%}
{% for s in cs.sections %}
<section class="cs-section{% if s.pdf_break %} cs-break{% endif %}" id="{{ s.id }}">
  <h2 class="cs-h2">{{ s.title }}</h2>
  {% for b in s.blocks %}{% include case_study/block.liquid b=b %}{% endfor %}
</section>
{% endfor %}
<section class="cs-section cs-learn" id="lessons">
  <h2 class="cs-h2">{{ cs.learn_title | default: "Looking back" }}</h2>
  <ul class="cs-list">{% for it in cs.learn %}<li>{% include case_study/md.liquid t=it %}</li>{% endfor %}</ul>
</section>
</body></html>
