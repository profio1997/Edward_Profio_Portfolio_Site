---
layout: default
---
{%- comment -%} Book detail page: cover on the left, details on the right. Prefers the downloaded local cover. {%- endcomment -%}
{% assign cover_src = '' %}
{% if page.cover %}
  {% capture cover_src %}{{ page.cover | prepend: '/' | relative_url }}{% endcapture %}
{% elsif page.isbn %}
  {% capture has_local_cover %}{% file_exists assets/img/book_covers/isbn-{{ page.isbn }}.jpg %}{% endcapture %}
  {% if has_local_cover == 'true' %}
    {% capture cover_src %}{{ '/assets/img/book_covers/isbn-' | append: page.isbn | append: '.jpg' | relative_url }}{% endcapture %}
  {% else %}
    {% capture cover_src %}https://covers.openlibrary.org/b/isbn/{{ page.isbn }}-L.jpg?default=false{% endcapture %}
  {% endif %}
{% endif %}
{% assign status = page.status | default: 'Finished' | strip %}
{% assign status_label = status | upcase %}
{% if status_label == 'READING' %}{% assign status_label = 'IN PROGRESS' %}{% endif %}
{% assign read_date = page.finished | default: page.date %}

<script>
  window.bookCoverFallback = function (img) {
    var stage = parseInt(img.getAttribute('data-stage') || '0', 10);
    var isbn = img.getAttribute('data-isbn');
    if (stage === 0 && isbn) {
      img.setAttribute('data-stage', '1');
      img.src = 'https://books.google.com/books/content?vid=ISBN' + isbn + '&printsec=frontcover&img=1&zoom=1';
      return;
    }
    img.onerror = null;
    var tile = document.createElement('div');
    tile.className = 'cover-fallback';
    tile.textContent = img.getAttribute('data-title') || '';
    img.replaceWith(tile);
  };
</script>

<div class="post book-detail">
  <p class="book-detail__back"><a href="{{ '/books/' | relative_url }}"><i class="fa-solid fa-arrow-left fa-sm" aria-hidden="true"></i> Back to the bookshelf</a></p>

  <div class="book-detail__layout">
    <div class="book-detail__cover">
      {% if cover_src != '' %}
        <img alt="{{ page.title | escape }} cover" src="{{ cover_src }}" data-isbn="{{ page.isbn }}" data-title="{{ page.title | escape }}" onerror="bookCoverFallback(this)">
      {% else %}
        <div class="cover-fallback">{{ page.title }}</div>
      {% endif %}
    </div>

    <div class="book-detail__body">
      <h1 class="book-detail__title">{{ page.title }}</h1>
      {% if page.author %}<p class="book-detail__author">by {{ page.author }}</p>{% endif %}

      <ul class="book-detail__facts">
        <li class="status status-{{ status | downcase }}">
          {% if page.favorite %}<i class="fa-solid fa-star" aria-hidden="true"></i> {% endif %}{{ status_label }}
        </li>
        {% if read_date %}
          <li>{% if status == 'Reading' %}Started{% else %}Finished{% endif %} {{ read_date | date: '%B %Y' }}</li>
        {% endif %}
        {% if page.released %}<li>First published {{ page.released }}</li>{% endif %}
      </ul>

      {% assign cats = page.categories | join: '' %}
      {% if cats != '' %}
        <p class="book-detail__chips">
          {% for category in page.categories %}
            <a href="{{ category | slugify | prepend: '/books/category/' | relative_url }}">{{ category | replace: '-', ' ' }}</a>
          {% endfor %}
        </p>
      {% endif %}

      {% if content != '' %}
        <div class="book-detail__review">{{ content }}</div>
      {% endif %}

      <p class="book-detail__links">
        {% if page.isbn %}<a target="_blank" rel="noopener" href="https://openlibrary.org/isbn/{{ page.isbn }}">Open Library</a>{% endif %}
        {% if page.buy_link %}<a target="_blank" rel="noopener" href="{{ page.buy_link }}">Buy this book</a>{% endif %}
      </p>
    </div>
  </div>

  {% if site.giscus and page.giscus_comments %}
    {% include giscus.liquid %}
  {% endif %}
</div>
