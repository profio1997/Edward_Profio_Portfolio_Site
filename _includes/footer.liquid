{%- comment -%}No copyright line. The footer only renders if footer_text is set in _config.yml.{%- endcomment -%}
{% capture footer_contents %}{{ site.footer_text }}{% if site.impressum_path %} <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.{% endif %}{% if site.last_updated %} Last updated: {{ 'now' | date: '%B %d, %Y' }}.{% endif %}{% endcapture %}
{% assign footer_check = footer_contents | strip %}
{% if footer_check != '' %}
  <footer class="sticky-bottom mt-5" role="contentinfo">
    <div class="container">
      {{ footer_contents }}
    </div>
  </footer>
{% else %}
  <div class="page-end-space" aria-hidden="true"></div>
{% endif %}
