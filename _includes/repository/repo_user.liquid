{% comment %}
  GitHub profile card. The avatar comes straight from github.com/<user>.png and the
  name / bio / counts are filled in by assets/js/github-repos.js. If the API is
  unavailable the card still renders with the username and a link to the profile.
{% endcomment %}
{% assign gu = site.data.github_cache.user %}
{% capture has_photo %}{% file_exists assets/img/profile.jpg %}{% endcapture %}
<div class="repo-user-card" data-user="{{ include.username }}"{% if gu %} data-rendered="true"{% endif %}>
  <a class="repo-user-card__link" href="https://github.com/{{ include.username }}" target="_blank" rel="noopener noreferrer">
    <img
      class="repo-user-card__avatar"
      src="{% if has_photo == 'true' %}{{ '/assets/img/profile.jpg' | relative_url }}{% else %}https://github.com/{{ include.username }}.png?size=160{% endif %}"
      alt="{{ include.username }} on GitHub"
      width="80"
      height="80"
      loading="lazy"
    >
    <div class="repo-user-card__body">
      <div class="repo-user-card__name">{% if gu.name %}{{ gu.name }}{% else %}{{ include.username }}{% endif %}</div>
      <div class="repo-user-card__handle">@{{ include.username }}</div>
      {% if gu %}
        {% if gu.bio %}<p class="repo-user-card__bio">{{ gu.bio | escape }}</p>{% endif %}
        <div class="repo-user-card__meta">
          {%- assign shown_repos = 0 -%}
          {%- for r in site.data.github_cache.repos -%}
            {%- if site.data.repositories.github_repos contains r.full_name -%}{%- assign shown_repos = shown_repos | plus: 1 -%}{%- endif -%}
          {%- endfor -%}
          <span class="gh-stat"><i class="fa-solid fa-book-bookmark"></i> {{ shown_repos }} repos</span>
          <span class="gh-stat"><i class="fa-solid fa-user-group"></i> {{ gu.followers }} {% if gu.followers == 1 %}follower{% else %}followers{% endif %}</span>
          <span class="gh-stat"><i class="fa-solid fa-user-plus"></i> {{ gu.following }} following</span>
        </div>
      {% else %}
        <p class="repo-user-card__bio" hidden></p>
        <div class="repo-user-card__meta" hidden></div>
      {% endif %}
    </div>
  </a>
</div>
