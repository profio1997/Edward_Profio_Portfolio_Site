{% comment %}
  Repository card rendered on the server from _data/github_cache.json (written by bin/refresh_site_data.py),
  so it shows real details even where the browser cannot call the GitHub API. assets/js/github-repos.js
  replaces these with live data when it can.
{% endcomment %}
{% assign r = include.repo %}
<div class="repo-card" data-repo="{{ r.full_name }}" data-rendered="true">
  <a class="repo-card__link" href="{{ r.html_url }}" target="_blank" rel="noopener noreferrer">
    <div class="repo-card__header">
      <i class="fa-solid fa-book-bookmark repo-card__icon"></i>
      <span class="repo-card__name">{{ r.name }}</span>
    </div>
    {% if r.description and r.description != '' %}<p class="repo-card__desc">{{ r.description | escape }}</p>{% endif %}
    {% if r.stargazers_count and r.stargazers_count > 0 %}
      <div class="repo-card__meta">
        <span class="gh-stat" title="Stars"><i class="fa-solid fa-star"></i> {{ r.stargazers_count }}</span>
      </div>
    {% endif %}
  </a>
</div>
